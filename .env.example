# Copy this file to `.env` and fill it in. Never commit `.env`.

# Port of the Nukkad server. Hosting providers set this themselves.
# In development (`npm run dev`) the server always uses 8787.
PORT=8787

# MongoDB connection string. Leave empty in dev: map areas are then cached
# in memory and in the .cache/ folder on disk.
MONGODB_URI=

# REQUIRED before deploying. A contact (website URL or a project email) that is
# sent to OpenStreetMap services in our User-Agent, as their usage policies ask.
# Do not put a personal email here.
OSM_CONTACT=

# Overpass servers, comma-separated, tried in order.
OVERPASS_URLS=https://overpass-api.de/api/interpreter

# Websites allowed to call the API in production, comma-separated
# (for example the Vercel URL of the web app). Empty = same-origin only.
ALLOWED_ORIGINS=

# Set to 1 when the server runs behind a host's proxy (Render, Railway, ...).
TRUST_PROXY=0

# Web app -> server URL for production builds. Empty = same origin (dev proxy).
VITE_SERVER_URL=
